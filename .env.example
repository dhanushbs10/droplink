# Base URL of the deployed site. Used for canonical, sitemap, robots, and
# Open Graph URLs. This must match the origin the app is actually served from,
# otherwise share links and SEO tags point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://droplink1.vercel.app

# Supabase project URL and anon public key (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key

# URL of the signaling server.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# Signaling server port (server only).
SIGNALING_PORT=3001

# Comma-separated list of allowed origins for the signaling server
# (server only). Leave empty for local development to allow all origins.
# In production, set this to your frontend origin, e.g. https://droplink.app
SIGNALING_ORIGINS=

# Set to 1 to enable verbose signaling server logs (server only).
# Leave unset in production.
SIGNALING_DEBUG=